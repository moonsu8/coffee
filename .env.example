# 복사해서 쓰세요. 실제 값 파일(.env.local, .env.test.local)은 *.local 이라 커밋되지 않습니다.
# 이 파일에는 값을 적지 마세요. service_role 키와 DB 비밀번호는 어디에도 넣지 않습니다.

# ── 운영 프로젝트 (앱에 들어가는 공개 값: Project URL, anon key) → .env.local
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 테스트 프로젝트 (RLS 테스트 전용. 운영과 다른 프로젝트) → .env.test.local
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
